APP_PORT=8080
APP_NAME="Punto Madera"
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
VITE_WHATSAPP_NUMBER=593998897813
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=stderr
LOG_LEVEL=info
RUN_MIGRATIONS=true

# Optional production tracking. Leave blank to disable each integration.
GOOGLE_ANALYTICS_ID=
META_PIXEL_ID=

# Server-side rendering: the container runs the Inertia SSR server next to Apache
# so crawlers receive full HTML. Set to false to fall back to client rendering.
INERTIA_SSR_ENABLED=true

# LocalBusiness structured data. Keep identical to the Google Business Profile.
# BUSINESS_PHONE defaults to the WhatsApp number when left blank.
BUSINESS_PHONE=
BUSINESS_STREET_ADDRESS=
# schema.org format, e.g. "Mo-Fr 08:00-18:00, Sa 08:00-13:00"
BUSINESS_OPENING_HOURS=
# Comma-separated profile URLs (Google Business Profile, Instagram, Facebook...)
BUSINESS_SAME_AS=
